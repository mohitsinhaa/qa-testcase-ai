# Copy this file to .env for local development and fill in your key.
# NEVER commit the real .env file to git.
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: change the model used (default: gemini-2.5-flash, free-tier friendly)
GEMINI_MODEL=gemini-2.5-flash

# Port (Render sets this automatically, safe to leave default for local use)
PORT=3000
